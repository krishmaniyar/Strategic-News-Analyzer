# Strategic News Analyzer — Backend Environment Variables
# Copy to .env for local development. See backend/deploy/env.production.template for production.

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ANON_KEY=YOUR_SUPABASE_ANON_KEY
SERVICE_ROLE=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Groq API ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
GROQ_DAILY_TOKEN_BUDGET=500000

# ─── Ollama (local — embeddings only) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── News Source API Keys (all optional) ────────────────────────────────────
NEWS_API=YOUR_NEWSAPI_KEY
GNEWS_API=YOUR_GNEWS_KEY
MEDIASTACK_API=YOUR_MEDIASTACK_KEY
# GDELT is free, no key needed. Disable with: GDELT_ENABLED=false

# ─── Internal trigger auth ──────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TRIGGER_TOKEN=your-local-dev-token-here

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
