[Unit]
Description=Strategic News Analyzer API (FastAPI + APScheduler)
Documentation=https://github.com/krishmaniyar/Strategic-News-Analyzer
After=network-online.target ollama.service
Wants=network-online.target
# ollama.service only orders startup; Ollama readiness is checked by the app's
# own health_check() before each embedding batch — don't rely on After= for readiness.

[Service]
Type=simple
User=strategic-news
Group=strategic-news
WorkingDirectory=/opt/strategic-news/backend
EnvironmentFile=/opt/strategic-news/.env.production

# --workers 1 is deliberate: single vCPU, single process, APScheduler runs
# ingestion in its own OS thread. More workers would each spin up their own
# APScheduler and attempt to run the ingestion job concurrently.
ExecStart=/opt/strategic-news/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strategic-news-api

# Memory limits (cgroup v2 — native on Ubuntu 24.04)
# MemoryHigh: soft throttle (kernel slows allocation, triggers swap)
# MemoryMax: hard limit (process killed if exceeded — OOMKiller)
MemoryHigh=300M
MemoryMax=350M

# Security hardening — no container boundary protects us now
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/strategic-news

[Install]
WantedBy=multi-user.target
