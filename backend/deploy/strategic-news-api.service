[Unit]
Description=Strategic News Analyzer API (FastAPI + APScheduler)
Documentation=https://github.com/krishmaniyar/Strategic-News-Analyzer
After=network-online.target ollama.service
Wants=network-online.target
# ollama.service only orders startup; Ollama readiness is checked by the app's
# own health_check() before each embedding batch — don't rely on After= for readiness.

[Service]
Type=simple
User=strategic-news
Group=strategic-news
WorkingDirectory=/opt/strategic-news/backend
EnvironmentFile=/opt/strategic-news/.env.production

# --workers 1 is deliberate: single vCPU (AWS t3.small/t3.micro), single process,
# APScheduler runs ingestion in its own OS thread. More workers would each
# spin up their own APScheduler and attempt to run the ingestion job concurrently.
ExecStart=/opt/strategic-news/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strategic-news-api

# Memory limits (cgroup v2 — native on Ubuntu 24.04)
# Tuned for AWS t3.small (2 GB RAM):
#   t3.small budget: FastAPI=500M, Ollama=700M, OS+Nginx=~150M → peak ~1.35GB of 2GB
# If using t3.micro (1 GB): lower these to MemoryHigh=250M / MemoryMax=300M
#   and rely on the 2GB swap file as safety net.
MemoryHigh=450M
MemoryMax=500M

# Security hardening — no container boundary protects us now
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/strategic-news

[Install]
WantedBy=multi-user.target
