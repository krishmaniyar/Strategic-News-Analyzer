# Strategic News Analyzer — .env.production template
# Copy to /opt/strategic-news/.env.production on the VM
# PERMISSIONS: chmod 600 /opt/strategic-news/.env.production
# OWNER: chown strategic-news:strategic-news /opt/strategic-news/.env.production
#
# WARNING: This file is on a shared VM with no container boundary.
# 600 permissions + correct ownership is the only thing preventing credential leaks.
# NEVER commit this file to git. NEVER make it world-readable.

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ANON_KEY=YOUR_SUPABASE_ANON_KEY
SERVICE_ROLE=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Use the pooled connection string (port 6543) for better connection handling
# on a serverless/single-process setup. Find in Supabase → Settings → Database
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Groq API ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
GROQ_DAILY_TOKEN_BUDGET=500000

# ─── Ollama (running locally on same VM — embeddings only) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── News Source API Keys ────────────────────────────────────────────────────
# All optional — adapters skip gracefully if empty. Set what you have.
NEWS_API=YOUR_NEWSAPI_KEY
GNEWS_API=YOUR_GNEWS_KEY
MEDIASTACK_API=YOUR_MEDIASTACK_KEY
# GDELT is free and enabled by default — no key needed
# GDELT_ENABLED=true

# ─── Internal Trigger Auth ──────────────────────────────────────────────────
# Static bearer token for POST /internal/trigger-ingestion
# Generate a new one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TRIGGER_TOKEN=YOUR_GENERATED_TOKEN_HERE

# ─── App Settings ────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated or JSON array of allowed CORS origins
CORS_ORIGINS=["https://YOUR_VERCEL_APP.vercel.app","https://YOUR_CUSTOM_DOMAIN.com"]
